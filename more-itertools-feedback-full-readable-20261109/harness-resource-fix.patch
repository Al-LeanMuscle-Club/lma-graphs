+"""Regression checks for this experiment's exact resource exception."""
+import hashlib
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+from nanolize import rewrite
+
+class FrozenResourceBoundaryTests(unittest.TestCase):
+    def check(self, root, name):
+        return rewrite._protected_files(root, {'files':{}}, {'check':{name:{}}}, {name:{}})
+
+    def test_matching_frozen_declaration_is_preserved(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);name='interface.pyi';data=b'x: int\n';(root/name).write_bytes(data)
+            with patch.object(rewrite,'_PRESERVED_PUBLIC_RESOURCES',{name:hashlib.sha256(data).hexdigest()}):
+                self.assertEqual(self.check(root,name),[name])
+
+    def test_changed_resource_is_not_silently_preserved(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);name='interface.pyi';(root/name).write_text('x: str\n')
+            with patch.object(rewrite,'_PRESERVED_PUBLIC_RESOURCES',{name:hashlib.sha256(b'x: int\n').hexdigest()}):
+                with self.assertRaisesRegex(ValueError,'freeze production'):
+                    self.check(root,name)
+
+    def test_runtime_source_is_still_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);name='more.py';(root/name).write_text('x = 1\n')
+            with self.assertRaisesRegex(ValueError,'freeze production'):
+                self.check(root,name)
+
+    def test_symbolic_link_still_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);name='interface.pyi';data=b'x: int\n';(root/'target').write_bytes(data)
+            (root/name).symlink_to(root/'target')
+            with patch.object(rewrite,'_PRESERVED_PUBLIC_RESOURCES',{name:hashlib.sha256(data).hexdigest()}):
+                with self.assertRaisesRegex(ValueError,'ordinary non-linked'):
+                    self.check(root,name)
+
+    def test_actual_allowlist_contains_no_package_runtime_source(self):
+        self.assertEqual(len(rewrite._PRESERVED_PUBLIC_RESOURCES),5)
+        self.assertFalse(any(p.startswith('more_itertools/') and p.endswith('.py')
+            for p in rewrite._PRESERVED_PUBLIC_RESOURCES))
+
+if __name__=='__main__': unittest.main()
